# -----------------------------------------------------------------------------
# Binance PnL Terminal - Environment Variables Example
# -----------------------------------------------------------------------------
# Copy this file to .env.local and populate with your credentials:
#   cp .env.example .env.local
# -----------------------------------------------------------------------------

# Binance Read-Only API Credentials
# Create keys at: https://www.binance.com/en/my/settings/api-management
#
# IMPORTANT SECURITY RULES:
# 1. Enable ONLY "Read-Only" (Can Read) permissions.
# 2. DO NOT enable "Enable Spot & Margin Trading".
# 3. DO NOT enable "Enable Withdrawals".
# 4. Bind your IP address if possible for maximum security.
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Application Port (Optional, default: 3000)
PORT=3000
